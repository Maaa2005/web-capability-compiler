__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
dist/
build/
*.egg-info/

# Local WCC data: sessions, templates, and SQLite storage never belong in git.
.wcc/
*.sqlite
*.sqlite3

# Benchmark output is regenerated; committed results live under benchmarks/results/.
benchmarks/results/*.tmp
# A smoke run checks the harness on one task; it is not a result of record.
benchmarks/results/smoke/

.DS_Store
.reviews/

# Loop-harness state, which is a scratch file rather than a fact about the repo.
loop_status.md

# Held-out captures are screenshots and text of other people's sites. Their
# SHA-256 is in captures/index.json; the files themselves stay local.
benchmarks/results/heldout-*/captures/*.png
benchmarks/results/heldout-*/captures/*.txt
