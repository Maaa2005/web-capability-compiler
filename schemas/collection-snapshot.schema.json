{
  "$defs": {
    "CollectionKind": {
      "description": "Specification 8.4 repeated-structure categories.",
      "enum": [
        "list",
        "table",
        "cards",
        "search_results"
      ],
      "title": "CollectionKind",
      "type": "string"
    },
    "CollectionRecord": {
      "additionalProperties": false,
      "description": "One extracted record inside a collection.\n\n``identity`` is the deterministic per-record projection that feeds\n``collection_hash`` (specification 8.4). ``evidence_element_ids`` preserves the\nmapping back to the DOM elements that produced the record.",
      "properties": {
        "activation_locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocatorChain"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "entity_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity Id"
        },
        "evidence_element_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Element Ids",
          "type": "array"
        },
        "fields": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Fields",
          "type": "object"
        },
        "identity": {
          "title": "Identity",
          "type": "string"
        },
        "link_only": {
          "default": false,
          "title": "Link Only",
          "type": "boolean"
        },
        "record_id": {
          "title": "Record Id",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "identity"
      ],
      "title": "CollectionRecord",
      "type": "object"
    },
    "Confidence": {
      "description": "Specification 7.4. Only ``medium`` and ``high`` may become templates.",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "LocatorCandidate": {
      "additionalProperties": false,
      "description": "One way to find an element again.\n\n``key`` holds the matching value for the candidate kind: the ``id`` value, the\ncontrol ``name``, the accessible name, the label text, or a structural path\nrooted at the nearest landmark or form ancestor. A structural path may carry\ntag-index information, but execution must never fall back to a global\nnth-child-only path, a bounding box, a screenshot coordinate, or a selector\nsupplied by an external agent.",
      "properties": {
        "form_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Form Id"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/LocatorKind"
        },
        "landmark_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Landmark Id"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        }
      },
      "required": [
        "kind",
        "key"
      ],
      "title": "LocatorCandidate",
      "type": "object"
    },
    "LocatorChain": {
      "additionalProperties": false,
      "description": "All applicable candidates for one element, plus the primary candidate.\n\nRe-resolution (specification 7.7) walks ``candidates`` in priority order and\naccepts only an exactly-one match. Zero matches and ambiguous matches both\ncontinue to the next candidate; the closest element is never chosen.",
      "properties": {
        "candidates": {
          "items": {
            "$ref": "#/$defs/LocatorCandidate"
          },
          "minItems": 1,
          "title": "Candidates",
          "type": "array"
        },
        "primary": {
          "$ref": "#/$defs/LocatorCandidate"
        }
      },
      "required": [
        "primary",
        "candidates"
      ],
      "title": "LocatorChain",
      "type": "object"
    },
    "LocatorKind": {
      "description": "Candidate kinds in priority order (specification 7.6).\n\nLower value means higher priority, so a chain sorts by ``kind`` directly.",
      "enum": [
        1,
        2,
        3,
        4,
        5
      ],
      "title": "LocatorKind",
      "type": "integer"
    }
  },
  "additionalProperties": false,
  "description": "A repeated structure detected on the page (specification 8.4).\n\n``order_is_meaningful`` tells the verifier whether ``collection_hash`` must be\nsensitive to record order.",
  "properties": {
    "collection_hash": {
      "title": "Collection Hash",
      "type": "string"
    },
    "collection_id": {
      "title": "Collection Id",
      "type": "string"
    },
    "confidence": {
      "$ref": "#/$defs/Confidence",
      "default": "low"
    },
    "kind": {
      "$ref": "#/$defs/CollectionKind"
    },
    "label": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Label"
    },
    "order_is_meaningful": {
      "default": true,
      "title": "Order Is Meaningful",
      "type": "boolean"
    },
    "record_count": {
      "default": 0,
      "title": "Record Count",
      "type": "integer"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/CollectionRecord"
      },
      "title": "Records",
      "type": "array"
    },
    "truncated": {
      "default": false,
      "title": "Truncated",
      "type": "boolean"
    }
  },
  "required": [
    "collection_id",
    "kind",
    "collection_hash"
  ],
  "title": "CollectionSnapshot",
  "type": "object"
}
