{
  "$defs": {
    "Confidence": {
      "description": "Specification 7.4. Only ``medium`` and ``high`` may become templates.",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "One recorded observation supporting a claim.\n\n``element_id`` and ``collection_id`` are snapshot-scoped: they name something\nin the snapshot this IR was built from, not something in the live page. A\nreader that wants the live element must re-resolve it, which is exactly the\nboundary specification 7.7 draws.",
      "properties": {
        "attribute": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribute"
        },
        "collection_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Collection Id"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "element_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Element Id"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "snapshot_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snapshot Id"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Something the page is about (specification 7.5).\n\n``available_actions`` stays empty until Phase 4 binds capabilities to\nentities. It is declared now because specification 7.11 makes entity\nreferences the way result items are addressed, and a model that gains the\nfield later would change the persisted shape after templates exist.",
  "properties": {
    "available_actions": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Available Actions",
      "type": "array"
    },
    "confidence": {
      "$ref": "#/$defs/Confidence",
      "default": "low"
    },
    "entity_id": {
      "title": "Entity Id",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "label": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Label"
    },
    "properties": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Properties",
      "type": "object"
    },
    "type": {
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "entity_id",
    "type",
    "evidence"
  ],
  "title": "Entity",
  "type": "object"
}
